---
import type { ApiEntry } from '../lib/content';
import { formatDate } from '../lib/content';
import { getCategory } from '../data/categories';
import type { CollectionEntry } from 'astro:content';
import { route, koreanCategories, koreanStatus } from '../lib/i18n';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

interface Props {
  api: ApiEntry;
  featured?: boolean;
  translation?: CollectionEntry<'koApis'>;
}

const { api, featured = false, translation } = Astro.props;
const ko = Boolean(translation);
const profilePath = route(`apis/${api.id}/`, ko ? 'ko' : 'en');
const category = getCategory(api.data.category);
---

<article class:list={['provider-card', { featured }]} style={`--card-accent:${category.accent}`}>
  <div class="card-topline">
    <span class="category-dot" aria-hidden="true"></span>
    <a href={`${base}/categories/${api.data.category}/`}>{ko ? `${koreanCategories[api.data.category]} (영문)` : category.name}</a>
    <span class={`status status-${api.data.status}`}>{ko ? koreanStatus[api.data.status] : api.data.status}</span>
  </div>
  <h3><a href={profilePath}>{translation?.data.title ?? api.data.name}</a></h3>
  <p>{translation?.data.summary ?? api.data.summary}</p>
  <dl class="card-facts">
    {!ko && <div><dt>Auth</dt><dd>{api.data.auth}</dd></div>}
    <div><dt>{ko ? '원문 확인일' : 'Verified'}</dt><dd><time datetime={formatDate(api.data.verifiedAt)}>{formatDate(api.data.verifiedAt)}</time></dd></div>
  </dl>
  <a class="text-link" href={profilePath}>{ko ? '공급자 정보 보기' : 'Open profile'} <span aria-hidden="true">→</span></a>
</article>
