---
import { formatDate } from '../lib/content';
import type { ApiEntry } from '../lib/content';

interface Props {
  verifiedAt: Date;
  sourceUrls: string[];
  facts?: ApiEntry['data']['mutableFacts'];
  lang?: 'en' | 'ko';
}

const { verifiedAt, sourceUrls, facts = [], lang = 'en' } = Astro.props;
const ko = lang === 'ko';
const labels: Record<string, string> = { 'base-url': '기본 URL', authentication: '인증', pricing: '가격·이용권', 'rate-limits': '호출 한도' };
const host = (url: string) => new URL(url).hostname.replace(/^www\./, '');
---

<aside class="source-panel" aria-labelledby="source-panel-title">
  <div class="source-heading">
    <div>
      <span class="eyebrow">{ko ? '출처·확인 범위' : 'Provenance'}</span>
      <h2 id="source-panel-title">{ko ? '확인한 정보와 공식 출처' : 'Verified facts, visible sources'}</h2>
    </div>
    <span class="verified-stamp">{ko ? '원문 확인일' : 'Checked'} {formatDate(verifiedAt)}</span>
  </div>
  {ko && <p>아래 값은 원문 공급자 정보(영문)를 그대로 표시합니다. 번역 검토일은 가격·한도나 API 동작의 새 확인일이 아닙니다.</p>}
  {facts.length > 0 && (
    <dl class="fact-provenance">
      {facts.map((fact) => (
        <div>
          <dt>{ko ? labels[fact.key ?? ''] ?? `${fact.label} (영문)` : fact.label}</dt>
          <dd>
            <span lang={ko ? 'en' : undefined}>{fact.value}</span>
            <a href={fact.sourceUrl} rel="noopener noreferrer">{ko ? '출처' : 'Source'} · {host(fact.sourceUrl)}</a>
            <time datetime={formatDate(fact.verifiedAt)}>{ko ? '확인일' : 'Verified'} {formatDate(fact.verifiedAt)}</time>
          </dd>
        </div>
      ))}
    </dl>
  )}
  <h3>{ko ? '공식 출처' : 'Official sources'}</h3>
  <ol class="source-list">
    {sourceUrls.map((url) => (
      <li><a href={url} rel="noopener noreferrer">{url}</a></li>
    ))}
  </ol>
</aside>
