---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { formatDate } from '../lib/content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const latestCatalogReview = formatDate(new Date(Math.max(...(await getCollection('apis')).map((entry) => entry.data.verifiedAt.getTime()))));

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  noIndex?: boolean;
  lang?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'API Atlas',
  description = 'A concise, source-backed atlas of APIs for developers and retrieval systems.',
  canonicalPath = Astro.url.pathname,
  noIndex = false,
  jsonLd,
  lang = 'en',
} = Astro.props;

const pageTitle = title === 'API Atlas' ? title : `${title} · API Atlas`;
const canonical = new URL(canonicalPath, Astro.site ?? Astro.url.origin);
const currentPath = Astro.url.pathname;
const navItems = [
  [`${base}/apis/`, 'APIs'],
  [`${base}/categories/`, 'Categories'],
  [`${base}/compare/`, 'Compare'],
  [`${base}/guides/`, 'Guides'],
  [`${base}/changes/`, 'Changes'],
];

const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'API Atlas',
  url: new URL(`${base}/`, Astro.site ?? Astro.url.origin).href,
  description,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${new URL(`${base}/search/`, Astro.site ?? Astro.url.origin).href}?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

const schemas = jsonLd ? [siteSchema, ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd])] : [siteSchema];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />
    <meta name="theme-color" content="#0d1512" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    {noIndex && <meta name="robots" content="noindex,follow" />}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schemas).replaceAll('<', '\\u003c')} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header" data-pagefind-ignore>
      <a class="brand" href={`${base}/`} aria-label="API Atlas home">
        <span class="brand-mark" aria-hidden="true">A:</span>
        <span>API Atlas</span>
      </a>
      <nav aria-label="Primary navigation">
        {navItems.map(([href, label]) => (
          <a href={href} aria-current={currentPath.startsWith(href) ? 'page' : undefined}>{label}</a>
        ))}
      </nav>
      <a class="search-link" href={`${base}/search/`} aria-label="Search API Atlas">
        <span aria-hidden="true">⌕</span> Search
      </a>
    </header>
    <main id="main-content" data-pagefind-body={!noIndex ? true : undefined}>
      <slot />
    </main>
    <footer class="site-footer" data-pagefind-ignore>
      <div>
        <a class="brand footer-brand" href={`${base}/`}><span class="brand-mark">A:</span> API Atlas</a>
        <p>Concise API intelligence, traced to official sources.</p>
      </div>
      <div class="footer-links">
        <a href={`${base}/sources/`}>Source policy</a>
        <a href={`${base}/about/`}>About</a>
        <a href={`${base}/api/catalog.json`}>Catalog JSON</a>
        <a href={`${base}/llms.txt`}>llms.txt</a>
      </div>
      <p class="footer-note">No crawler cloaking. No bot-driven ad impressions. Latest profile verification: {latestCatalogReview}.</p>
      <p class="footer-powered">Powered by <a href="https://getbeta.app">GetBeta</a> — dividend portfolio intelligence.</p>
    </footer>
  </body>
</html>
