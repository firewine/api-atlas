---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProviderCard from '../../components/ProviderCard.astro';
import { getKoreanApis, getKoreanGuides, getKoreanComparisons } from '../../lib/translations';
import { route, guidePriority } from '../../lib/i18n';
const guides = (await getKoreanGuides()).sort((a,b) => guidePriority(a.source.id) - guidePriority(b.source.id));
const apis = (await getKoreanApis()).sort((a,b) => Number(b.source.id === 'seibro') - Number(a.source.id === 'seibro'));
const comparisons = await getKoreanComparisons();
---
<BaseLayout lang="ko" title="한국어 API 비교·배당 데이터 연동 가이드" description="SEIBRO 세이브로 배당 수집과 EODHD 한국 배당 날짜 누락, ECOS 환율 검증을 다룹니다. 공식 출처와 코드·시험의 검증 범위를 함께 확인하세요.">
  <header class="page-hero"><div class="shell">
    <span class="eyebrow">GetBeta · API Atlas 한국어</span>
    <h1 class="page-title">한국 개발자를 위한 API 선택과 연동 가이드</h1>
    <p class="lede">세이브로 배당금 수집부터 시장별 출처 선택까지, 실제 연동에서 마주치는 문제를 확인합니다. 문서 조사·구현 확인·시험 기록의 범위를 구분하고, 확인하지 못한 정보는 그대로 남깁니다.</p>
    <a class="button" href={route('search/', 'ko')}>한국어 문서 검색</a>
  </div></header>
  <section class="section-tight"><div class="shell">
    <div class="section-heading"><div><span class="eyebrow">먼저 읽을 실전 사례</span><h2>한국 배당 데이터, 어디까지 확인했나요?</h2></div><a class="text-link" href={route('guides/', 'ko')}>한국어 가이드 전체 보기 →</a></div>
    <div class="guide-grid">{guides.map(({source,translation}) => <a class="guide-card" href={route(`guides/${source.id}/`, 'ko')}>
      <h3>{translation.data.title}</h3><p>{translation.data.summary}</p>
    </a>)}</div>
  </div></section>
  <section class="dark-section section"><div class="shell">
    <div class="section-heading"><div><span class="eyebrow">출처와 제약</span><h2>한국어 공급자 소개</h2></div><p>API 접근 권한과 이용 조건은 공급자별로 확인해야 합니다. 조사 단계인 서비스를 안정적인 공개 API로 간주하지 않습니다.</p></div>
    <div class="provider-grid">{apis.map(({source,translation}) => <ProviderCard api={source} translation={translation} />)}</div>
  </div></section>
  <section class="section"><div class="shell">
    <div class="section-heading"><div><span class="eyebrow">용도에 맞게 선택하기</span><h2>한국 공공 금융 API 비교</h2></div></div>
    <div class="guide-grid">{comparisons.map(({source,translation}) => <a class="guide-card" href={route(`compare/${source.id}/`, 'ko')}><h3>{translation.data.title}</h3><p>{translation.data.summary}</p></a>)}</div>
    <p>전체 공급자·비교 자료는 <a href={route('apis/')}>영문 API 목록</a>에서도 볼 수 있습니다. 한국어 문서는 검토한 범위부터 추가합니다.</p>
  </div></section>
</BaseLayout>
