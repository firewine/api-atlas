---
import { getCollection } from 'astro:content';
import ProviderView from '../../components/ProviderView.astro';
export async function getStaticPaths() {
  return (await getCollection('apis')).map((api) => ({ params: { slug: api.id }, props: { api } }));
}
---
<ProviderView api={Astro.props.api} />
