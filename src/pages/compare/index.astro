---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { sortApis, type ApiEntry } from '../../lib/content';

const apis = sortApis(await getCollection('apis'));
const comparisons = (await getCollection('comparisons')).sort((a, b) => a.data.order - b.data.order);
const rows: Array<[string, (api: ApiEntry) => string]> = [
  ['Category', (api) => api.data.category],
  ['Authentication', (api) => api.data.auth],
  ['Base URL', (api) => api.data.baseUrl],
  ['Pricing shape', (api) => api.data.pricing],
  ['Rate limits', (api) => api.data.rateLimit],
  ['Protocols', (api) => api.data.protocols.join(', ')],
  ['Formats', (api) => api.data.formats.join(', ')],
];
---

<BaseLayout title="Compare APIs" description="Compare normalized API facts and open source-backed head-to-head guides.">
  <header class="page-hero"><div class="shell">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Compare' }]} />
    <span class="eyebrow">Decision desk</span><h1 class="page-title">Compare without the marketing fog.</h1>
    <p class="lede">Use the matrix for orientation, then open a substantive comparison for tradeoffs and source context.</p>
  </div></header>
  <section class="section-tight"><div class="shell">
    <h2>Quick matrix</h2>
    <p>Select up to four providers. The first three are shown by default.</p>
    <div class="compare-picker" data-pagefind-ignore>
      {apis.map((api, index) => <label><input type="checkbox" value={api.id} checked={index < 3} /> {api.data.name}</label>)}
    </div>
    <p id="compare-note" role="status" class="category-count" data-pagefind-ignore>Select between two and four providers.</p>
    <div class="table-scroll">
      <table class="compare-table">
        <thead><tr><th scope="col">Fact</th>{apis.map((api, index) => <th scope="col" data-provider={api.id} hidden={index >= 3}><a href={`/apis/${api.id}/`}>{api.data.name}</a></th>)}</tr></thead>
        <tbody>{rows.map(([label, value]) => <tr><th scope="row">{label}</th>{apis.map((api, index) => <td data-provider={api.id} hidden={index >= 3}>{value(api)}</td>)}</tr>)}</tbody>
      </table>
    </div>
  </div></section>
  <section class="section" style="background:var(--paper-deep)"><div class="shell">
    <div class="section-heading"><div><span class="eyebrow">Head to head</span><h2>Substantive comparisons.</h2></div><p>Every comparison points back to provider-level official sources.</p></div>
    <div class="comparison-grid">{comparisons.map((comparison) => <a class="comparison-card" href={`/compare/${comparison.id}/`}>
      <span class="category-count">Verified 2026-09-13</span><h3>{comparison.data.title}</h3><p>{comparison.data.summary}</p>
    </a>)}</div>
  </div></section>
  <script is:inline>
    const boxes = Array.from(document.querySelectorAll('.compare-picker input'));
    const note = document.querySelector('#compare-note');
    const refresh = (changed) => {
      let selected = boxes.filter((box) => box.checked);
      if (selected.length > 4 && changed) changed.checked = false;
      selected = boxes.filter((box) => box.checked);
      const ids = new Set(selected.map((box) => box.value));
      document.querySelectorAll('[data-provider]').forEach((cell) => { cell.hidden = !ids.has(cell.dataset.provider); });
      note.textContent = selected.length < 2 ? 'Select at least two providers.' : `${selected.length} providers selected.`;
    };
    boxes.forEach((box) => box.addEventListener('change', () => refresh(box)));
    refresh();
  </script>
</BaseLayout>
