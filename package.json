{
  "name": "api-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro sync && astro check",
    "validate:content": "node scripts/validate-content.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "validate": "npm run check && npm run build && npm run validate:content && npm run verify:dist",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "latest",
    "astro": "^7.3.0",
    "typescript": "latest"
  },
  "devDependencies": {
    "pagefind": "latest"
  }
}
